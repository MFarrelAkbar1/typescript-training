{
  "name": "ts-training",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "test:ex": "vitest run --typecheck",
    "test:watch": "vitest --typecheck",
    "test:day1": "vitest run --typecheck days/day1",
    "test:day2": "vitest run --typecheck days/day2",
    "test:day3": "vitest run --typecheck days/day3",
    "test:day4": "vitest run --typecheck days/day4",
    "test:day5": "vitest run --typecheck days/day5",
    "test:day6": "vitest run --typecheck days/day6",
    "test:day7": "vitest run --typecheck days/day7",
    "test:project": "vitest run --typecheck project",
    "test:solutions": "vitest run --typecheck --config vitest.solutions.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.solutions.json",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "tsx project/server/db/migrate.ts",
    "dev:server": "tsx watch project/server/index.ts",
    "dev:web": "vite --config project/web/vite.config.ts"
  },
  "devDependencies": {
    "@fastify/jwt": "^10.2.6",
    "@fastify/websocket": "^11.3.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "jsdom": "^29.1.1",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
